---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkCard from '../components/WorkCard.astro';
import DevCard from '../components/DevCard.astro';
import VideoCard from '../components/VideoCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import site from '../data/site.json';
import worksData from '../data/works.json';
import projectsData from '../data/projects.json';
import videosData from '../data/videos.json';
import galgame from '../data/galgame-items.json';
import gameArt from '../data/game-art.json';

const works = worksData.works;
const projects = projectsData.projects;
const videos = videosData.videos;
const homeVideos = [...videos.filter((video) => video.featured), ...videos.filter((video) => !video.featured)].slice(0, 2);

const hero = works.find((work) => work.slug === 'ruins-echo') || works[0];
const featured = works.filter((work) => work.featured).slice(0, 5);
const heroWorks = featured.length ? featured : [hero];
const inDevelopment = projects.filter((project) => project.featured).slice(0, 2);

const categoryCounts = galgame.categories
  .map((name) => ({ name, count: galgame.items.filter((item) => item.category === name).length }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);

const marquee = [
  'MONSTER GIRL : SYNTHESIS PARADISE',
  '魔物娘合成乐园',
  '半神容器',
  '异世界生存建造',
  '合成 · 炼金 · 符文',
  '区域 · 怪物 · 配方 · 编年史',
  'GAME ART',
  'WORLD BUILDING',
  'ILLUSTRATION',
];
---

<Base description={site.description} image={hero.cover}>
  <div class="home-bg" aria-hidden="true">
    <video
      class="home-bg__video"
      data-home-bg-video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/uploads/videos/game-bg-poster.jpg"
    >
      <source src="/uploads/videos/game-bg.mp4" type="video/mp4" />
    </video>
    <div class="home-bg__veil"></div>
    <div class="home-bg__grad" aria-hidden="true"></div>
  </div>

  <div class="home-content">
  <section class="hero wrap">
    <div class="hero__copy">
      <p class="hero__kicker">独立游戏开发者 · 插画 · 世界构建</p>
      <h1 class="hero__title">
        <span>EXPLODING</span>
        <span><em>TNT</em></span>
        <span class="hero__title-small">ARCHIVE / 2026</span>
      </h1>
      <p class="hero__lead">
        <strong>{site.statement}</strong><br />
        {site.intro}
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/works/">查看作品</a>
        <a class="btn" href="/about/">关于我</a>
      </div>
    </div>

    <figure class="hero__figure" data-hero-figure>
      <span class="hero__figure-glow" aria-hidden="true"></span>
      <img
        class="hero__figure-img"
        src="/uploads/wiki/characters/a-kui-v2.webp"
        alt="阿葵 · 《魔物娘合成乐园》主角"
        width="900"
        height="1600"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        data-hero-figure-img
      />
      <figcaption class="hero__figure-cap">
        <span class="hero__figure-name"><b>阿葵</b><i>AKUI</i></span>
        <span class="hero__figure-role">半神容器 / PROTAGONIST</span>
      </figcaption>
    </figure>

    <span class="hero__brackets" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span class="hero__vignette" aria-hidden="true"></span>

    <div class="hero__scroll" aria-hidden="true">SCROLL</div>
  </section>

  <div class="marquee marquee--band" aria-hidden="true">
    <div class="marquee__inner">
      {[0, 1].map(() => (
        <div class="marquee__group">
          {marquee.map((word) => (
            <><span>{word}</span><i></i></>
          ))}
        </div>
      ))}
    </div>
  </div>

  <section class="section wrap" id="works">
    <SectionHead index="01" en="SELECTED WORKS" title="作品" link="/works/" />
    <div class="works-home">
      {featured.map((work) => <WorkCard work={work} />)}
    </div>
    <div class="works-home__more">
      <a class="link-arrow" href="/works/all/">显示更多全部作品</a>
    </div>
  </section>

  <section class="section wrap" id="gameart">
    <SectionHead index="02" en="GAME ART / RANDOM" title="魔物娘合成乐园 · 立绘与 CG" link="/works/all/" linkLabel="全部作品" />
    <div class="gameart-grid" data-gameart-grid>
      {gameArt.items.slice(0, 8).map((art) => (
        <a class="gameart-card" href={art.charUrl || '/wiki/'} data-gameart-card>
          <img src={art.src} alt={art.title} loading="lazy" decoding="async" data-gameart-img />
          <span class="gameart-card__cap">
            <b data-gameart-title>{art.title}</b>
            <span data-gameart-cat>{art.category}</span>
          </span>
        </a>
      ))}
    </div>
    <p class="gameart-note">
      每次刷新随机抽 8 张。全部 {gameArt.count} 张（{gameArt.counts['角色立绘']} 张立绘、{gameArt.counts['Q 版']} 张 Q 版、{gameArt.counts['游戏CG']} 张 CG）都在
      <a href="/works/all/">全部作品</a> 里，点开看大图。
    </p>
    <script
      is:inline
      type="application/json"
      id="gameart-pool"
      set:html={JSON.stringify(gameArt.items.map((a) => ({ s: a.src, t: a.title, c: a.category, u: a.charUrl || '/wiki/' })))}
    />
  </section>

  <section class="section wrap" id="projects">
    <SectionHead index="03" en="IN DEVELOPMENT" title="在做的东西" link="/projects/" />
    <div class="dev-grid">
      {inDevelopment.map((project) => <DevCard project={project} />)}
    </div>
  </section>

  <section class="section wrap" id="videos">
    <SectionHead index="04" en="MOTION / VIDEOS" title="视频" link="/videos/" />
    <div class="video-grid">
      {homeVideos.map((video) => <VideoCard video={video} />)}
    </div>
  </section>

  <section class="section wrap" id="codex">
    <SectionHead index="05" en="CODEX / WIKI" title="图鉴与设定" link="/codex/" />
    <div class="codex-teaser">
      <div class="codex-teaser__body">
        <p class="kicker">CODEX / 图鉴</p>
        <h3 class="codex-teaser__title">
          {galgame.count} 件物品，{galgame.craftableCount} 个配方，<br />
          都能查到怎么来、能做什么。
        </h3>
        <p class="codex-teaser__text">
          从《魔物娘合成乐园》的物品表直接导入。可以按分类浏览、搜名字，也能顺着配方一路查下去。
          《魔物娘合身乐园》的生存百科正在从飞书 wiki 搬进来。
        </p>
        <div class="codex-teaser__stats">
          <div class="codex-stat"><b>{galgame.count}</b><span>物品</span></div>
          <div class="codex-stat"><b>{galgame.craftableCount}</b><span>配方</span></div>
          <div class="codex-stat"><b>{galgame.categories.length}</b><span>分类</span></div>
        </div>
        <a class="link-arrow" href="/codex/">打开图鉴</a>
      </div>
      <div class="codex-teaser__index">
        <p class="codex-teaser__index-title">按分类浏览 / BY CATEGORY</p>
        {categoryCounts.map((cat) => (
          <a class="codex-index-row" href="/codex/synthesis/">
            <span>{cat.name}</span>
            <b>{String(cat.count).padStart(2, '0')}</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap" id="about">
    <SectionHead index="06" en="ABOUT" title="关于" link="/about/" linkLabel="更多关于我" />
    <div class="about-strip">
      <blockquote class="about-strip__quote">
        白天画画，<br />
        晚上搭世界。<br />
        <em>把想做的世界，<br />一个一个做出来。</em>
      </blockquote>
      <div class="about-strip__body">
        <p>
          我是 EXPLODINGTNT，独立游戏开发者，也是画师。做过 3D 场景、角色、UI 和像素美术，
          现在把大部分时间花在自己的游戏上。
        </p>
        <p>
          这个网站是我的档案：作品、项目、设定集，和从以前到现在做过的所有东西。
        </p>
        <SocialLinks />
      </div>
    </div>
  </section>
  </div>

  <button class="home-audio" type="button" data-home-audio aria-pressed="false" aria-label="开关首页背景音乐">
    <span class="home-audio__dot" aria-hidden="true"></span>
    <span data-home-audio-label>声音：关</span>
  </button>
</Base>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-home-bg-video]');
  const button = document.querySelector<HTMLButtonElement>('[data-home-audio]');
  const label = button?.querySelector<HTMLElement>('[data-home-audio-label]');

  const sync = () => {
    if (!video || !button || !label) return;
    const on = !video.muted;
    button.setAttribute('aria-pressed', String(on));
    label.textContent = on ? '声音：开' : '声音：关';
  };

  if (video) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.pause();
      video.removeAttribute('autoplay');
    } else {
      video.play().catch(() => {});
    }
  }

  button?.addEventListener('click', () => {
    if (!video) return;
    video.muted = !video.muted;
    if (video.paused) video.play().catch(() => {});
    sync();
  });

  sync();
</script>

<script>
  const heroSlides = Array.from(document.querySelectorAll<HTMLImageElement>('[data-hero-slide]'));
  const heroLink = document.querySelector<HTMLAnchorElement>('[data-hero-link]');
  const heroTitle = document.querySelector<HTMLElement>('[data-hero-title]');
  const heroEn = document.querySelector<HTMLElement>('[data-hero-en]');
  const heroYear = document.querySelector<HTMLElement>('[data-hero-year]');
  const heroPlate = document.querySelector<HTMLElement>('[data-hero-plate]');
  let heroIndex = 0;
  let heroTimer: number | undefined;

  const showHeroSlide = (index: number) => {
    heroSlides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
    const slide = heroSlides[index];
    if (!slide) return;
    if (heroLink && slide.dataset.href) heroLink.href = slide.dataset.href;
    if (heroTitle) heroTitle.textContent = slide.dataset.title || '';
    if (heroEn) heroEn.textContent = slide.dataset.en || '';
    if (heroYear) heroYear.textContent = slide.dataset.year || '';
  };

  const startHeroTimer = () => {
    if (heroSlides.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    heroTimer = window.setInterval(() => {
      heroIndex = (heroIndex + 1) % heroSlides.length;
      showHeroSlide(heroIndex);
    }, 5000);
  };

  startHeroTimer();
  heroPlate?.addEventListener('mouseenter', () => window.clearInterval(heroTimer));
  heroPlate?.addEventListener('mouseleave', startHeroTimer);
</script>

<script>
  // 立绘随光标的极轻微视差（±8px），rAF + 缓动，静止即停
  const figImg = document.querySelector<HTMLElement>('[data-hero-figure-img]');
  const canParallax =
    !!figImg &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (canParallax && figImg) {
    let tx = 0;
    let ty = 0;
    let cx = 0;
    let cy = 0;
    let raf = 0;

    const tick = () => {
      cx += (tx - cx) * 0.12;
      cy += (ty - cy) * 0.12;
      figImg.style.transform = `translate3d(${cx.toFixed(2)}px,${cy.toFixed(2)}px,0)`;
      if (Math.abs(tx - cx) > 0.12 || Math.abs(ty - cy) > 0.12) {
        raf = requestAnimationFrame(tick);
      } else {
        raf = 0;
        figImg.style.transform = `translate3d(${tx}px,${ty}px,0)`;
      }
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType && e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
        const nx = (e.clientX / window.innerWidth - 0.5) * 2;
        const ny = (e.clientY / window.innerHeight - 0.5) * 2;
        tx = nx * -8;
        ty = ny * -5;
        if (!raf) raf = requestAnimationFrame(tick);
      },
      { passive: true }
    );
  }
</script>

<script>
  // 首页「立绘与 CG」每次刷新随机抽 8 张
  const poolEl = document.getElementById('gameart-pool');
  const artGrid = document.querySelector<HTMLElement>('[data-gameart-grid]');
  if (poolEl && artGrid) {
    type Art = { s: string; t: string; c: string; u: string };
    let pool: Art[] = [];
    try {
      pool = JSON.parse(poolEl.textContent || '[]');
    } catch {
      pool = [];
    }
    const cards = Array.from(artGrid.querySelectorAll<HTMLAnchorElement>('[data-gameart-card]'));
    if (pool.length > cards.length) {
      const shuffled = [...pool];
      for (let i = shuffled.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      cards.forEach((card, i) => {
        const item = shuffled[i];
        if (!item) return;
        card.href = item.u;
        const img = card.querySelector<HTMLImageElement>('[data-gameart-img]');
        if (img) {
          img.src = item.s;
          img.alt = item.t;
        }
        const title = card.querySelector<HTMLElement>('[data-gameart-title]');
        if (title) title.textContent = item.t;
        const cat = card.querySelector<HTMLElement>('[data-gameart-cat]');
        if (cat) cat.textContent = item.c;
      });
    }
  }
</script>
