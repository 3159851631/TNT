---
import Base from '../../../layouts/Base.astro';
import survival from '../../../data/survival-codex.json';

const entries = survival.entries;
const byTitle = new Map(entries.map((entry) => [entry.title, entry]));

export function getStaticPaths() {
  const allEntries = survival.entries;
  return allEntries.map((entry, index) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prev: index > 0 ? allEntries[index - 1] : null,
      next: index < allEntries.length - 1 ? allEntries[index + 1] : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const recipe = (entry.recipe || []).map((material) => ({
  ...material,
  related: byTitle.get(material.name) || null,
}));
const related = entries.filter(
  (item) => item.category === entry.category && item.slug !== entry.slug
).slice(0, 3);
const paragraphs = (entry.body || []).map((paragraph: string | { paragraph?: string }) =>
  typeof paragraph === 'string' ? paragraph : paragraph.paragraph || ''
);
const bodyLines = paragraphs.filter(
  (paragraph, index) => !(index === 0 && paragraph.slice(0, 120) === entry.summary)
);
const blocks = bodyLines.map((paragraph) => {
  if (paragraph.startsWith('### ')) return { type: 'h' as const, text: paragraph.slice(4) };
  if (paragraph.startsWith('- ')) return { type: 'li' as const, text: paragraph.slice(2) };
  return { type: 'p' as const, text: paragraph };
});
---

<Base title={`${entry.title} — 生存百科`} description={entry.summary}>
  <div class="wrap">
    <p class="page-head__kicker" style="padding-top: 40px">
      <a href="/codex/" style="color: var(--muted)">CODEX</a> /
      <a href="/codex/survival/" style="color: var(--muted)">合身乐园 · 生存百科</a> / {entry.category}
    </p>

    <div class="item-hero">
      <div class="item-hero__icon">
        <span style="font-family: var(--serif); font-size: 54px; color: var(--rose-bright);">
          {entry.category.slice(0, 1)}
        </span>
      </div>
      <div>
        <p class="item-hero__kicker">{entry.category}</p>
        <h1 class="item-hero__title">{entry.title}</h1>
        <p class="item-hero__note">{entry.summary}</p>
        <div class="item-hero__tags">
          {entry.stats.slice(0, 3).map(([key, value]) => (
            <span class="tag">{key} · {value}</span>
          ))}
        </div>
      </div>
    </div>

    <div class="detail-grid">
      <div class="detail-body prose">
        <p class="lead">{entry.summary}</p>
        {blocks.map((block) =>
          block.type === 'h' ? (
            <h3>{block.text}</h3>
          ) : block.type === 'li' ? (
            <p class="list-line">· {block.text}</p>
          ) : (
            <p>{block.text}</p>
          )
        )}

        {recipe.length > 0 && (
          <section style="margin-top: 34px">
            <h2>配方</h2>
            <div class="recipe-list">
              {recipe.map((material) => (
                <div class="recipe-row">
                  <span class="recipe-row__icon"></span>
                  <span class="recipe-row__name">
                    {material.related ? (
                      <a href={`/codex/survival/${material.related.slug}/`}>{material.name}</a>
                    ) : (
                      material.name
                    )}
                  </span>
                  <span class="recipe-row__qty">×{material.qty}</span>
                </div>
              ))}
            </div>
            {entry.station && (
              <p style="margin-top: 14px; font-size: 13px" class="muted">
                制作站：{entry.station}
              </p>
            )}
          </section>
        )}
      </div>

      <aside>
        <dl class="meta-list">
          <div><dt>分类</dt><dd>{entry.category}</dd></div>
          {entry.stats.map(([key, value]) => (
            <div><dt>{key}</dt><dd>{value}</dd></div>
          ))}
          {entry.station && <div><dt>制作站</dt><dd>{entry.station}</dd></div>}
        </dl>
        <p class="muted" style="margin-top: 18px; font-size: 11.5px; line-height: 1.8">
          示例条目。飞书 wiki 导入后会替换成完整内容。
        </p>
      </aside>
    </div>

    {(entry.images || []).length > 0 && (
      <div class="detail-gallery" style="margin-top: 12px">
        {(entry.images || []).map((src: string) => (
          <img src={src} alt={entry.title} loading="lazy" decoding="async" />
        ))}
      </div>
    )}

    {related.length > 0 && (
      <section style="padding-bottom: 40px">
        <h2 class="subhead" style="font-size: 24px">同类条目</h2>
        <div class="codex-grid">
          {related.map((item) => (
            <a class="item-card" href={`/codex/survival/${item.slug}/`}>
              <div class="item-card__top">
                <span class="item-card__cat">{item.category}</span>
              </div>
              <span class="item-card__name">{item.title}</span>
              <span class="item-card__desc">{item.summary}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="detail-nav" aria-label="条目翻页">
      {prev ? (
        <a href={`/codex/survival/${prev.slug}/`}>
          <span>上一个条目</span>
          {prev.title}
        </a>
      ) : (
        <span></span>
      )}
      {next ? (
        <a href={`/codex/survival/${next.slug}/`}>
          <span>下一个条目</span>
          {next.title}
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  </div>
</Base>
