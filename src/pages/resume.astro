---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import projectsData from '../data/projects.json';

const projects = projectsData.projects.filter((project) =>
  ['monster-girl-synthesis', 'summer-pop', 'thought-poker', 'sky-garbage-man'].includes(project.slug)
);
const skills = [
  'UE 引擎',
  'Photoshop',
  'MAYA',
  'ZBrush',
  'Unity',
  'Blender',
  'Figma',
  'Premiere',
  'Aseprite',
  '插画',
  '动画',
  '游戏原画',
  '游戏模型',
  'UI 设计',
];
const participated = '命骸、雨之残響、魔物娘合成乐园、情绪戳手、夏日泡浮、terminus';
const experience = [
  {
    title: '新加坡 Terminus | 终极宇宙项目组',
    role: '游戏主美术 & 视觉总监',
    period: '2023.08 — 2024.07',
    points: [
      '主导游戏界面视觉开发，构建 500+ 组件 UI 库，开发周期缩短 50%。',
      '优化渲染管线，支持 Discord 平台峰值 10,243 人同时在线，P95 留存率提升 18%。',
      '与程序团队协同实现动态光照系统，场景加载效率提升 22%。',
    ],
  },
  {
    title: '新次元教育信息咨询服务中心',
    role: '地编美术设计师 & 外包总监',
    period: '2024.07 — 2025.06',
    points: [
      '建立留学生孵化体系，辅导 327 人完成商业作品，通过率 91%。',
      '研发同步实时交互工具，制作场景效率 +60%。',
      '外包项目客户满意度 98.7%，KPI 完成 142%。',
    ],
  },
  {
    title: 'Bilibili 绘画区 UP',
    role: '视频制作 / 绘画内容',
    period: '2025.03 — 2025.07',
    points: [
      '视频类型：制作游戏与绘画相关内容的视频。',
      '视频数据：双账号累计播放 15.5 万。',
      '创意、文案、配音、录制、剪辑、封面与字幕由本人独立完成。',
    ],
  },
];
const awards = [
  '2025 Third Visual in SFK X GGJ 2025 独立游戏视觉奖',
  '2025 一带一路暨金砖国家技能发展与技术创新大赛 国赛三等奖',
  '2025 一带一路暨金砖国家技能发展与技术创新大赛 省赛优秀奖',
  '2024 江西省大学生科技创新竞赛 三等奖',
  '2022 第一届技能竞赛 平面设计技术赛 一等奖',
];
---

<Base
  title="简历"
  description="王君 / EXPLODINGTNT 的简历：游戏美术、视觉设计、3D 场景、角色、UI 与独立游戏开发。"
>
  <div class="wrap">
    <header class="page-head">
      <p class="page-head__kicker">RESUME / 简历</p>
      <h1 class="page-head__title">简历 <em>CV</em></h1>
      <p class="page-head__lead">
        王君 / EXPLODINGTNT。游戏美术、视觉设计与独立游戏开发。<br />
        完整简历为图片版；下面是网页版。
      </p>
      <p class="no-print" style="margin-top: 26px; display: flex; flex-wrap: wrap; gap: 12px">
        <a class="btn btn--primary" href="/resume.pdf" download>下载简历 PDF</a>
        <a class="btn" href="/uploads/resume/wangjun-resume.png" target="_blank" rel="noopener">查看简历原图</a>
        <button class="btn" type="button" data-print>打印网页版</button>
      </p>
    </header>

    <article class="resume">
      <div class="resume__head">
        <div>
          <h2 class="resume__name">王君</h2>
          <p class="resume__role">EXPLODINGTNT · 游戏美术 / 视觉设计 / 独立游戏开发</p>
        </div>
        <div class="resume__contact">
          <span>20 岁 · 江西赣州</span>
          <a href="tel:18879742281">18879742281</a>
          <a href="mailto:3159851631@qq.com">3159851631@qq.com</a>
          <span>B站主号 / B站小号 / YouTube / X / Patreon / itch.io</span>
        </div>
      </div>

      <section class="resume__section">
        <div class="resume__label">简介 / PROFILE</div>
        <div class="resume__content">
          <p>
            视觉传达艺术设计专科，游戏美术 / 视觉设计。做过游戏主美术与视觉总监、地编美术与外包总监，
            也自己做独立游戏、画插画、做视频。能独立完成 3D 场景、角色、UI、像素美术和游戏原型。
          </p>
          <p style="margin-top: 10px">参与项目：{participated}</p>
        </div>
      </section>

      <section class="resume__section">
        <div class="resume__label">教育 / EDUCATION</div>
        <div class="resume__content">
          <div class="resume__item">
            <div class="resume__item-head">
              <h3 class="resume__item-title">赣州职业技术学院</h3>
              <span class="resume__item-meta">2020.09 — 2025.07 · 专科</span>
            </div>
            <p>视觉传达艺术设计。主修插画设计、动画设计、游戏原画、游戏模型设计、UI 设计、角色制作与角色建模。</p>
          </div>
        </div>
      </section>

      <section class="resume__section">
        <div class="resume__label">技能 / SKILLS</div>
        <div class="resume__content">
          <div class="resume__skills">
            {skills.map((skill) => <span>{skill}</span>)}
          </div>
        </div>
      </section>

      <section class="resume__section">
        <div class="resume__label">经历 / EXPERIENCE</div>
        <div class="resume__content">
          {experience.map((item) => (
            <div class="resume__item">
              <div class="resume__item-head">
                <h3 class="resume__item-title">{item.title}</h3>
                <span class="resume__item-meta">{item.period}</span>
              </div>
              <p style="margin-top: 4px; color: var(--ink-soft)">{item.role}</p>
              {item.points.map((point) => <p>· {point}</p>)}
            </div>
          ))}
        </div>
      </section>

      <section class="resume__section">
        <div class="resume__label">项目 / PROJECTS</div>
        <div class="resume__content">
          {projects.map((project) => (
            <div class="resume__item">
              <div class="resume__item-head">
                <h3 class="resume__item-title">{project.title}</h3>
                <span class="resume__item-meta">{project.period} · {project.role}</span>
              </div>
              <p>{project.summary}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="resume__section">
        <div class="resume__label">荣誉 / AWARDS</div>
        <div class="resume__content">
          {awards.map((award) => <p>· {award}</p>)}
        </div>
      </section>

      <section class="resume__section">
        <div class="resume__label">联系 / CONTACT</div>
        <div class="resume__content">
          <p style="margin-bottom: 16px">
            合作、约稿、工作机会，欢迎通过电话、邮箱或社交平台联系。
          </p>
          <div class="resume__skills" style="margin-bottom: 18px">
            <a class="resume__skills" href="tel:18879742281" style="text-decoration: none"><span>18879742281</span></a>
            <a class="resume__skills" href="mailto:3159851631@qq.com" style="text-decoration: none"><span>3159851631@qq.com</span></a>
          </div>
          <SocialLinks />
        </div>
      </section>
    </article>
  </div>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
