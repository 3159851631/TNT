---
interface Video {
  slug: string;
  title: string;
  en?: string;
  year: string;
  duration?: string;
  bvid?: string;
  youtubeId?: string;
  localSrc?: string;
  provider?: 'bilibili' | 'youtube' | 'local';
  account?: string;
  tag?: string;
  featured?: boolean;
  cover: string;
  description?: string;
}

interface Props {
  video: Video;
}

const { video } = Astro.props;
const hasVideo = Boolean(video.bvid || video.youtubeId || video.localSrc);
const provider = video.provider || (video.youtubeId ? 'youtube' : video.localSrc ? 'local' : 'bilibili');
const tag = video.tag || (video.account === '游戏实机' ? '实机' : '视频');
const canPreview = Boolean(video.localSrc);
---

<article class="video-card">
  <div class="video-card__cover">
    <img class="video-card__img" src={video.cover} alt={video.title} loading="lazy" decoding="async" />
    {canPreview && (
      <video
        class="video-card__preview"
        data-preview={video.localSrc}
        muted
        loop
        playsinline
        preload="none"
        poster={video.cover}
        aria-hidden="true"
        tabindex="-1"
      />
    )}

    <span class="video-card__line" aria-hidden="true"></span>

    {video.duration && <span class="video-card__dur">{video.duration}</span>}
    <span class="video-card__tag">{tag}</span>

    {hasVideo ? (
      <button
        class="video-card__play"
        type="button"
        data-provider={provider}
        data-bvid={video.bvid || ''}
        data-youtube={video.youtubeId || ''}
        data-local={video.localSrc || ''}
        data-title={video.title}
        aria-label={`播放 ${video.title}`}
      >
        <span></span>
      </button>
    ) : (
      <span class="video-card__hint-badge">视频待接入</span>
    )}

    <div class="video-card__cap">
      <span class="video-card__cap-main">
        <b>{video.title}</b>
        {video.en && <i>{video.en}</i>}
      </span>
      <span class="video-card__cap-year">{video.year}</span>
    </div>
  </div>
</article>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 悬停自动预览（仅本地视频，src 在第一次悬停时才加载）
  document.querySelectorAll<HTMLElement>('.video-card').forEach((card) => {
    if (card.dataset.previewBound === '1') return;
    card.dataset.previewBound = '1';
    const prev = card.querySelector<HTMLVideoElement>('[data-preview]');
    if (!prev) return;

    const stop = () => {
      prev.pause();
      try {
        prev.currentTime = 0;
      } catch (e) {
        /* ignore */
      }
      card.classList.remove('is-previewing');
    };

    card.addEventListener('pointerenter', () => {
      if (reduceMotion || card.classList.contains('is-playing')) return;
      if (!prev.src) prev.src = prev.dataset.preview || '';
      const p = prev.play();
      if (p && typeof p.catch === 'function') p.catch(() => {});
      card.classList.add('is-previewing');
    });
    card.addEventListener('pointerleave', stop);
    card.addEventListener('pointercancel', stop);
  });

  // 点击后把播放器插进封面，盖住封面文字
  document.querySelectorAll<HTMLButtonElement>('.video-card__play').forEach((button) => {
    if (button.dataset.bound === '1') return;
    button.dataset.bound = '1';
    button.addEventListener('click', () => {
      const cover = button.closest<HTMLElement>('.video-card__cover');
      const card = button.closest<HTMLElement>('.video-card');
      if (!cover || !card || card.classList.contains('is-playing')) return;

      const provider = button.dataset.provider || 'bilibili';
      const bvid = button.dataset.bvid || '';
      const youtubeId = button.dataset.youtube || '';
      const localSrc = button.dataset.local || '';
      if (provider === 'bilibili' && !bvid) return;
      if (provider === 'youtube' && !youtubeId) return;
      if (provider === 'local' && !localSrc) return;

      card.classList.add('is-playing');

      const preview = cover.querySelector<HTMLVideoElement>('[data-preview]');
      if (preview) {
        preview.pause();
        preview.removeAttribute('src');
      }

      if (provider === 'local') {
        const localVideo = document.createElement('video');
        localVideo.className = 'video-card__local';
        localVideo.controls = true;
        localVideo.autoplay = true;
        localVideo.playsInline = true;
        localVideo.preload = 'metadata';
        localVideo.src = localSrc;
        cover.appendChild(localVideo);
        return;
      }

      const iframe = document.createElement('iframe');
      iframe.className = 'video-card__iframe';
      iframe.loading = 'lazy';
      iframe.title = button.dataset.title || '视频播放器';
      iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture; encrypted-media');
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('scrolling', 'no');
      iframe.src =
        provider === 'youtube'
          ? `https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeId)}?autoplay=1&rel=0`
          : `https://player.bilibili.com/player.html?bvid=${encodeURIComponent(bvid)}&page=1&high_quality=1&danmaku=0&autoplay=1`;
      cover.appendChild(iframe);
    });
  });
</script>
