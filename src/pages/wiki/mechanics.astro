---
import WikiLayout from '../../layouts/WikiLayout.astro';

const systems = [
  ['生命', '基础生命值、受伤与死亡判定'],
  ['仇恨值', '怪物优先攻击谁，影响拉怪与队友保护'],
  ['击退', '攻击命中后的位移与硬直'],
  ['魔力和耐力值', '施法、冲刺、采集等行动消耗'],
  ['暴击值', '暴击率与暴击伤害'],
  ['经验值', '角色成长与等级'],
  ['伤害', '物理、元素与技能伤害'],
  ['防御', '减伤与抗性'],
  ['日夜状态', '白天/夜晚的怪物与事件变化'],
  ['复活点/重生', '死亡后的复活位置与惩罚'],
  ['成就', '探索、战斗、收集与剧情成就'],
  ['地图', '区域解锁、传送点与探索度'],
  ['掉落几率', '普通、精英、BOSS 的掉落规则'],
  ['新手引导', '开场教学与系统解锁'],
  ['任务栏', '主线、支线与日常任务'],
  ['基础设置', '画面、声音、按键与语言'],
  ['玩家状态', '饥饿、口渴、体力、温度等生存状态'],
  ['魔物娘合成台', '魔物娘合成与培养的核心界面'],
];
---

<WikiLayout
  title="机制"
  description="《魔物娘合成乐园》的游戏机制：生命、仇恨、击退、魔力、日夜、复活、成就、地图与玩家状态。"
  active="mechanics"
  breadcrumb={[{ label: '机制' }]}
>
  <article class="wiki-article">
    <header class="wiki-page-head">
      <p class="wiki-page-head__kicker">MECHANICS / 机制</p>
      <h1 class="wiki-page-head__title">机制 <em>MECHANICS</em></h1>
      <p class="wiki-page-head__lead">游戏里的基础系统、玩家状态和生存规则。数值和公式会随版本继续补。</p>
    </header>
    <div class="wiki-prose">
      <h2>系统总览</h2>
      <p>《魔物娘合成乐园》是异世界生存建造 + RPG。下面这些系统共同决定玩家怎么活、怎么打、怎么探索和怎么经营。</p>
      <div class="wiki-mech-grid">
        {systems.map(([name, desc]) => (
          <div class="wiki-mech-cell"><b>{name}</b><span>{desc}</span></div>
        ))}
      </div>

      <h2>日夜与事件</h2>
      <p>白天和夜晚会改变怪物种类、刷新和部分事件。部分区域还有沙尘暴、暴风雪、涨潮等环境事件，触发时间和影响范围以实际版本为准。</p>

      <h2>生存与成长</h2>
      <p>玩家有生命、魔力、耐力、饥饿、口渴、温度等状态。采集、战斗、探索和经营都会消耗资源；装备、药水、食物和队友可以提供恢复与增益。</p>

      <h2>待补充</h2>
      <p class="wiki-empty">具体数值、公式、状态阈值和版本改动还没有导入。你后续把表格发我，我按系统拆进这一页。</p>
    </div>
  </article>
</WikiLayout>
