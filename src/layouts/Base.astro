---
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/900.css';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '../styles/global.css';
import site from '../data/site.json';
import Rail from '../components/Rail.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ageGate?: boolean;
}

const { title, description, image, noindex, ageGate = true } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const desc = description || site.description;
const siteBase = Astro.site ?? new URL('https://tnt-game-site.pages.dev');
const canonical = new URL(Astro.url.pathname, siteBase);
const ogImage = new URL(image || '/og-default.jpg', siteBase);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#08070c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {ageGate && (
      <script is:inline>
        try {
          document.documentElement.classList.toggle('age-locked', sessionStorage.getItem('tnt-site-age') !== '1');
        } catch (e) {
          document.documentElement.classList.add('age-locked');
        }
      </script>
    )}

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: site.name,
        alternateName: site.cn,
        jobTitle: '独立游戏开发者 / 画师',
        description: site.description,
        url: siteBase.href,
      })}
    />

    <link rel="preconnect" href="https://unpkg.com" />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Rail />
    <Header />
    {ageGate && (
      <div class="age-gate" data-age-gate>
        <div class="age-gate__card">
          <p class="page-head__kicker">CONTENT NOTICE / 内容提示</p>
          <h1 class="age-gate__title">本网站包含成人向绘画</h1>
          <p>
            网站里包含人体练习和成人向作品，仅限 18 岁以上查看。请确认你的年龄。
          </p>
          <div class="age-gate__actions">
            <button class="btn btn--primary" type="button" data-age-enter>我已满 18 岁，进入</button>
            <a class="btn" href="/leave/">未满 18 岁，离开</a>
          </div>
        </div>
      </div>
    )}
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const progress = document.querySelector<HTMLElement>('.scroll-progress');
      const updateProgress = () => {
        if (!progress) return;
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        progress.style.width = max > 0 ? `${Math.min(100, (doc.scrollTop / max) * 100)}%` : '0%';
      };
      document.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();

      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.06, rootMargin: '0px 0px -40px 0px' }
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-visible'));
      }

      document.querySelectorAll<HTMLButtonElement>('[data-bvid]').forEach((button) => {
        button.addEventListener('click', () => {
          const bvid = button.dataset.bvid;
          const title = button.dataset.title || 'Bilibili video';
          const cover = button.closest('.video-card__cover');
          if (!bvid || !cover) return;
          const iframe = document.createElement('iframe');
          iframe.className = 'video-frame';
          iframe.src = `https://player.bilibili.com/player.html?bvid=${encodeURIComponent(
            bvid
          )}&page=1&high_quality=1&danmaku=0&autoplay=0`;
          iframe.title = title;
          iframe.allowFullscreen = true;
          iframe.setAttribute('scrolling', 'no');
          cover.replaceChildren(iframe);
        });
      });
    </script>
    {ageGate && (
      <script>
        const gateEl = document.querySelector<HTMLElement>('[data-age-gate]');
        document.querySelector('[data-age-enter]')?.addEventListener('click', () => {
          try {
            sessionStorage.setItem('tnt-site-age', '1');
          } catch (e) {
            // ignore storage errors
          }
          document.documentElement.classList.remove('age-locked');
          gateEl?.classList.add('is-hidden');
        });
      </script>
    )}
  </body>
</html>
