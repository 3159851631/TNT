---
import Base from '../../../layouts/Base.astro';
import survival from '../../../data/survival-codex.json';

const entries = survival.entries;
const categories = Array.from(new Set(entries.map((entry) => entry.category)));
---

<Base
  title="合身乐园 · 生存百科"
  description="《魔物娘合身乐园》的设定与图鉴：物品、配方、生物、地形、作物、角色。"
>
  <div class="wrap">
    <header class="page-head">
      <p class="page-head__kicker">
        <a href="/codex/" style="color: var(--muted)">CODEX</a> / 合身乐园
      </p>
      <h1 class="page-head__title">生存百科 <em>WIKI</em></h1>
      <p class="page-head__lead">
        采集、建造、种田、探索。这里会放《魔物娘合身乐园》的完整设定：
        每样东西怎么来、有什么用，每个地方有什么、会碰到谁。
      </p>
      <div class="page-head__meta">
        <span><b>{entries.length}</b> 条示例</span>
        <span>{categories.length} 个分类</span>
        <span>飞书 wiki 导入中</span>
      </div>
    </header>

    <div class="notice">
      <span>
        <b>当前是结构示例。</b>
        你飞书里的完整 wiki 导入后，这里会替换成真实条目；分类、搜索和配方反查的用法不变。
      </span>
    </div>

    <div class="codex-toolbar">
      <label class="codex-search">
        <input type="search" placeholder="搜条目名 / 分类…" data-search aria-label="搜索条目" />
      </label>
      <span class="filter-count" data-count>{entries.length} ENTRIES</span>
    </div>

    <div class="filter-bar" data-category-root>
      <span class="filter-bar__label">分类</span>
      <button class="chip is-active" type="button" data-category-filter="全部">全部</button>
      {categories.map((category) => (
        <button class="chip" type="button" data-category-filter={category}>{category}</button>
      ))}
    </div>

    <div class="codex-grid" data-codex-grid>
      {entries.map((entry, index) => (
        <a
          class="item-card"
          href={`/codex/survival/${entry.slug}/`}
          data-name={entry.title}
          data-category={entry.category}
        >
          <div class="item-card__top">
            <span class="item-card__cat">{entry.category}</span>
            <span class="item-card__id">#{String(index + 1).padStart(2, '0')}</span>
          </div>
          <span class="item-card__name">{entry.title}</span>
          <span class="item-card__desc">{entry.summary}</span>
          <span class="item-card__meta">
            {entry.stats.slice(0, 2).map(([key, value]) => <span>{key} · {value}</span>)}
          </span>
        </a>
      ))}
    </div>
    <p class="codex-empty" data-empty>没有找到匹配的条目。</p>
  </div>
</Base>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.item-card'));
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const categoryRoot = document.querySelector<HTMLElement>('[data-category-root]');

  let category = '全部';
  let query = '';

  const apply = () => {
    let shown = 0;
    cards.forEach((card) => {
      const matchesCategory = category === '全部' || card.dataset.category === category;
      const haystack = `${card.dataset.name || ''} ${card.dataset.category || ''}`.toLowerCase();
      const matchesQuery = !query || haystack.includes(query);
      const visible = matchesCategory && matchesQuery;
      card.classList.toggle('is-hidden', !visible);
      if (visible) shown += 1;
    });
    if (count) count.textContent = `${shown} ENTRIES`;
    if (empty) empty.classList.toggle('is-visible', shown === 0);
  };

  search?.addEventListener('input', () => {
    query = search.value.trim().toLowerCase();
    apply();
  });

  categoryRoot?.querySelectorAll<HTMLButtonElement>('[data-category-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      categoryRoot.querySelectorAll('[data-category-filter]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
      category = button.dataset.categoryFilter || '全部';
      apply();
    });
  });
</script>
