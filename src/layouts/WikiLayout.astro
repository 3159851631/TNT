---
import meta from '../data/wiki/meta.json';
import LegalFooter from '../components/LegalFooter.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/wiki.css';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  active?: string;
  breadcrumb?: Crumb[];
  ageGate?: boolean;
}

const { title, description, active = '', breadcrumb = [], ageGate = true } = Astro.props;
const pageTitle = title ? `${title} · ${meta.gameName} Wiki` : `${meta.gameName} · 游戏 Wiki`;
const desc = description || meta.tagline;
const categories = meta.categories;
const siteBase = Astro.site ?? new URL('https://tnt-game-site.pages.dev');
const canonical = new URL(Astro.url.pathname, siteBase);
const ogImage = new URL('/og-default.jpg', siteBase);
const wikiHome = new URL('/wiki/', siteBase).href;
const searchUrl = new URL('/wiki/search/', siteBase).href;
const gameUrl = new URL('/projects/monster-girl-synthesis/', siteBase).href;
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${meta.gameName} Wiki`,
  alternateName: [`${meta.gameName}攻略`, `${meta.gameName}百科`, meta.gameEn],
  url: wikiHome,
  inLanguage: 'zh-CN',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${searchUrl}?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
const gameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: meta.gameName,
  alternateName: ['半神容器', meta.gameEn],
  description: '异世界生存建造 × 魔物娘养成 × 合成经营的 2D 像素 RPG，含完整 Wiki：区域、角色、怪物、物品、武器、合成与剧情。',
  genre: ['RPG', 'Simulation', 'Indie'],
  gamePlatform: 'PC',
  applicationCategory: 'Game',
  operatingSystem: 'Windows',
  inLanguage: 'zh-CN',
  isAccessibleForFree: true,
  url: gameUrl,
  sameAs: [wikiHome],
  publisher: { '@type': 'Organization', name: 'EXPLODINGTNT' },
  author: { '@type': 'Person', name: 'EXPLODINGTNT', alternateName: '王君' },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#0b0f0c" />
    <meta name="author" content="EXPLODINGTNT" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${meta.gameName} Wiki`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(gameLd)} />
    <link rel="icon" href="/favicon-wiki.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/uploads/wiki/logos/game-icon.png" />
    <link rel="apple-touch-icon" href="/uploads/wiki/logos/game-icon-180.png" />
    <link rel="preload" as="font" type="font/ttf" href="/fonts/jyhphy-2.ttf" crossorigin />
    <ClientRouter />
    {ageGate && (
      <script is:inline>
        try {
          document.documentElement.classList.toggle('age-locked', sessionStorage.getItem('tnt-site-age') !== '1');
        } catch (e) {
          document.documentElement.classList.add('age-locked');
        }
      </script>
    )}
  </head>
  <body class="wiki-body">
    <a class="wiki-skip" href="#wiki-main">跳到正文</a>

    <header class="wiki-header">
      <a class="wiki-brand" href="/wiki/" aria-label={`${meta.gameName} Wiki 首页`}>
        {meta.logos.game && <img class="wiki-brand__logo" src={meta.logos.game} alt={`${meta.gameName} LOGO`} />}
        <span class="wiki-brand__text">
          <span class="wiki-brand__name">{meta.gameName}</span>
          <span class="wiki-brand__en">{meta.gameEn}</span>
        </span>
      </a>

      <nav class="wiki-nav" aria-label="Wiki 分类">
        {categories.map((category) => (
          <a
            href={category.url}
            class:list={['wiki-nav__link', active === category.key && 'is-active']}
          >
            {category.name}
          </a>
        ))}
      </nav>

      <div class="wiki-tools">
        <form class="wiki-search" action="/wiki/search/" method="get" role="search">
          <input type="search" name="q" placeholder="搜索区域 / 角色 / 怪物 / 物品…" aria-label="搜索 Wiki" />
          <button type="submit" aria-label="搜索">搜索</button>
        </form>
        <a class="wiki-back" href="/">作品站 ↗</a>
      </div>
    </header>

    {ageGate && (
      <div class="age-gate" data-age-gate>
        <div class="age-gate__card">
          <p class="wiki-kicker">CONTENT NOTICE / 内容提示</p>
          <h1 class="age-gate__title">本 Wiki 包含成人向内容</h1>
          <p>《魔物娘合成乐园》的角色、怪物、剧情和部分插画包含成人向内容，仅限 18 岁以上查看。</p>
          <div class="age-gate__actions">
            <button class="wiki-btn wiki-btn--primary" type="button" data-age-enter>我已满 18 岁，进入</button>
            <a class="wiki-btn" href="/leave/">未满 18 岁，离开</a>
          </div>
        </div>
      </div>
    )}

    {breadcrumb.length > 0 && (
      <nav class="wiki-crumbs" aria-label="面包屑">
        <a href="/wiki/">Wiki</a>
        {breadcrumb.map((crumb) => (
          <span class="wiki-crumbs__item">
            <i>/</i>
            {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <b>{crumb.label}</b>}
          </span>
        ))}
      </nav>
    )}

    <main class="wiki-main" id="wiki-main">
      <slot />
    </main>

    <footer class="wiki-footer">
      <div class="wiki-footer__top">
        <div class="wiki-footer__brand">
          {meta.logos.studio && <img class="wiki-footer__studio" src={meta.logos.studio} alt="EXPLODINGTNT studio LOGO" />}
          <div>
            <p class="wiki-footer__game">{meta.gameName}</p>
            <p class="wiki-footer__en">{meta.gameEn}</p>
            <p class="wiki-footer__tagline">{meta.tagline}</p>
          </div>
        </div>
        <div class="wiki-footer__cols">
          <div class="wiki-footer__col">
            <b>图鉴</b>
            {categories.slice(0, 5).map((category) => <a href={category.url}>{category.name}</a>)}
          </div>
          <div class="wiki-footer__col">
            <b>资料</b>
            {categories.slice(5).map((category) => <a href={category.url}>{category.name}</a>)}
          </div>
          <div class="wiki-footer__col">
            <b>站内</b>
            <a href="/">作品站</a>
            <a href="/works/">精选作品</a>
            <a href="/videos/">视频</a>
            <a href="/about/">关于</a>
          </div>
        </div>
      </div>
      <div class="wiki-footer__bottom">
        <p>《{meta.gameName}》游戏 Wiki · 设定与素材 © EXPLODINGTNT</p>
        <p>游戏仍在开发中，本 Wiki 会持续补充 · 内容以实际版本为准</p>
      </div>
      <LegalFooter />
    </footer>
    {ageGate && (
      <script>
        const gateEl = document.querySelector<HTMLElement>('[data-age-gate]');
        document.querySelector('[data-age-enter]')?.addEventListener('click', () => {
          try {
            sessionStorage.setItem('tnt-site-age', '1');
          } catch (e) {
            // ignore
          }
          document.documentElement.classList.remove('age-locked');
          gateEl?.classList.add('is-hidden');
        });
      </script>
    )}

    <div class="wiki-music" data-wiki-music transition:persist>
      <audio data-wiki-audio="a" src="/audio/flourishing-paradise.flac" preload="auto"></audio>
      <audio data-wiki-audio="b" src="/audio/flourishing-paradise.flac" preload="auto"></audio>
      <button class="wiki-music__btn" type="button" data-wiki-music-toggle aria-pressed="true" aria-label="背景音乐开关">
        <span class="wiki-music__icon" aria-hidden="true">♪</span>
        <span class="wiki-music__label" data-wiki-music-label>音乐 开</span>
      </button>
    </div>

  <script src="/wiki-music.js" defer></script>
  <script src="/wiki.js" defer></script>
</body>
</html>
