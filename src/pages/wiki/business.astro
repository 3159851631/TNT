---
import WikiLayout from '../../layouts/WikiLayout.astro';

const systems = [
  ['房产', '购买、升级和布置店铺/据点'],
  ['员工', '招聘、安排岗位、培养与工资'],
  ['资金', '收入、支出、贷款与投资'],
  ['侦探社', '接委托、调查、声望与线索'],
  ['进货（批发）', '批量采购、补货与库存'],
  ['定价', '商品售价、利润与顾客满意度'],
  ['招聘', '招募员工、冒险者与特殊人才'],
  ['维护', '设备、建筑与店铺的日常维护'],
  ['店铺管理', '排班、货架、清洁、口碑与扩张'],
];
---

<WikiLayout
  title="经营"
  description="《魔物娘合成乐园》的经营模式：房产、员工、资金、侦探社、进货、定价、招聘、维护与店铺管理。"
  active="business"
  breadcrumb={[{ label: '经营' }]}
>
  <article class="wiki-article">
    <header class="wiki-page-head">
      <p class="wiki-page-head__kicker">BUSINESS / 经营</p>
      <h1 class="wiki-page-head__title">经营 <em>BUSINESS</em></h1>
      <p class="wiki-page-head__lead">在主世界经营店铺、侦探社和房产。赚资金、招员工、进货定价，再把生意做大。</p>
    </header>
      <div class=wiki-article__hero><img src=/uploads/wiki/cg/hero-1.webp alt=魔物娘合成乐园 loading=lazy decoding=async /></div>

    <div class="wiki-prose">
      <h2>经营模式</h2>
      <p>经营模式是主世界的一条独立玩法线。玩家可以购买房产、开店、招聘员工、进货、定价、维护，并处理侦探社的委托。</p>
      <div class="wiki-mech-grid">
        {systems.map(([name, desc]) => (
          <div class="wiki-mech-cell"><b>{name}</b><span>{desc}</span></div>
        ))}
      </div>

      <h2>经营循环</h2>
      <p>进货 → 上架/定价 → 顾客购买 → 结算收入 → 支付工资/维护 → 升级店铺或扩招。侦探社委托会提供额外资金、线索和声望。</p>

      <h2>待补充</h2>
      <p class="wiki-empty">具体商品、价格、员工属性、委托表和升级成本还没有导入。后续会按经营系统拆成独立页面。</p>
    </div>
  </article>
</WikiLayout>
