---
import WikiLayout from '../../../layouts/WikiLayout.astro';
import data from '../../../data/wiki/items.json';
import weaponsData from '../../../data/wiki/weapons.json';

export function getStaticPaths() {
  return data.items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const related = data.items.filter((i) => i.id !== item.id && i.category === item.category).slice(0, 8);
const usedInItems = data.items.filter((i) => item.usedIn.includes(i.name));
const myWeapons = weaponsData.weapons.filter((w) => w.itemId === item.id);
const obtainTagClass = (w: any) =>
  w.obtain === '购买' ? 'is-buy' : w.obtain === '掉落' ? 'is-drop' : 'is-craft';
---

<WikiLayout
  title={item.name}
  description={`${item.name} · ${item.category}${item.craftable ? ' · 可合成' : ''}`}
  active="items"
  breadcrumb={[{ label: '物品', href: '/wiki/items/' }, { label: item.name }]}
>
  <div class="wiki-detail">
    <div class="wiki-detail__main">
      <header class="wiki-detail__head">
        <p class="wiki-detail__kicker">ITEM / 物品</p>
        <h1 class="wiki-detail__title">{item.name}</h1>
        <p class="wiki-detail__sub">{item.category}{item.tier ? ` · 层级 ${item.tier}` : ''}{item.station ? ` · ${item.station}` : ''}</p>
        <p class="wiki-detail__desc">{item.note || `${item.craftable ? '可以在制作站合成。' : '基础素材或拾取物。'}`}</p>
        <div class="wiki-detail__meta">
          {item.craftable ? <span class="wiki-tag wiki-tag--gold">可合成</span> : <span class="wiki-tag">素材 / 拾取</span>}
          <span class="wiki-tag">{item.category}</span>
          {item.station && <span class="wiki-tag">{item.station}</span>}
          {myWeapons.length > 0 && <a class="wiki-tag" href="/wiki/weapons/">武器图鉴 →</a>}
        </div>
      </header>

      <article class="wiki-prose">
        {myWeapons.length > 0 && (
          <>
            <h2>武器属性</h2>
            {myWeapons.map((w) => (
              <div class="wp-spec">
                {myWeapons.length > 1 && <h3 class="wp-spec__title">{w.name}{w.seriesKey === 'core' ? '（进化形态）' : ''}</h3>}
                <table class="wp-spec__table">
                  <tbody>
                    <tr class="is-group"><th colspan="2">战斗属性</th></tr>
                    <tr><th>元素</th><td><span class={`wp-el wp-el--${w.elementKey}`}>{w.element}</span></td></tr>
                    <tr><th>伤害</th><td><b class="wp-spec__dmg">{w.damage}</b></td></tr>
                    <tr><th>攻速</th><td>{w.speed || '未标注'}</td></tr>
                    <tr><th>系列</th><td>{weaponsData.series.find((s) => s.key === w.seriesKey)?.name || w.seriesKey}</td></tr>

                    <tr class="is-group"><th colspan="2">获取与配方</th></tr>
                    <tr><th>获取方式</th><td><span class={`wp-spec__obtain ${obtainTagClass(w)}`}>{w.obtain}</span></td></tr>
                    {w.price && <tr><th>售价</th><td>{w.price} 金币</td></tr>}
                    {w.dropFrom && <tr><th>掉落来源</th><td>击败{w.dropFrom}</td></tr>}
                    {w.recipe.length > 0 && (
                      <tr>
                        <th>武器表配方</th>
                        <td>
                          <span class="wp-spec__recipe">
                            {w.recipe.map((m, i) => (
                              <span class="wp-spec__mat">{i > 0 && <i>+</i>}{m.name}<b>×{m.qty}</b></span>
                            ))}
                          </span>
                        </td>
                      </tr>
                    )}
                    {w.station && <tr><th>制作站</th><td>{w.station}</td></tr>}

                    <tr class="is-group"><th colspan="2">{w.effectName ? `专属特效 · ${w.effectName}` : '说明与特效'}</th></tr>
                    <tr>
                      <th>效果</th>
                      <td class="wp-spec__effect">{w.effect}</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            ))}
          </>
        )}

        <h2>物品信息</h2>
        <p>{item.note || '这个物品的详细说明还在补充。'}</p>

        <h2>获取方式{item.craftable && myWeapons.length > 0 ? ' · 物品表配方' : ''}</h2>
        {item.craftable ? (
          <>
            <p>在 <strong>{item.station || '制作站'}</strong> 合成：</p>
            <ul>
              {item.materials.length > 0 ? item.materials.map((material) => {
                const target = data.items.find((i) => i.name === material.name);
                return <li>{target ? <a href={`/wiki/items/${target.id}/`}>{material.name}</a> : material.name} <b class="wiki-mono">×{material.qty}</b></li>;
              }) : <li class="wiki-muted">配方材料待补充</li>}
            </ul>
            <p>产出：{item.output || '1'} 个。</p>
          </>
        ) : (
          <p>基础素材，通过采集、挖矿、怪物掉落或拾取获得。</p>
        )}

        {item.usedIn.length > 0 && (
          <>
            <h2>用于合成</h2>
            <ul>
              {item.usedIn.map((name) => {
                const target = data.items.find((i) => i.name === name);
                return <li>{target ? <a href={`/wiki/items/${target.id}/`}>{name}</a> : name}</li>;
              })}
            </ul>
          </>
        )}

        <h2>说明</h2>
        <p class="wiki-muted">{item.craftable ? '配方来自游戏物品表与合成表。数值和用途会随版本更新。' : '基础素材/拾取物，具体掉落来源会继续补。'}</p>
      </article>

      {related.length > 0 && (
        <section class="wiki-related">
          <h2>同类物品</h2>
          <div class="wiki-related__grid">
            {related.map((i) => <a class="wiki-related__link" href={`/wiki/items/${i.id}/`}>{i.name} <span class="wiki-mono">{i.category}</span></a>)}
          </div>
        </section>
      )}
    </div>

    <aside class="wiki-detail__aside">
      <div class="wiki-infobox">
        <div class="wiki-infobox__image-wrap" style="display:flex;align-items:center;justify-content:center;min-height:180px">
          {item.icon ? (
            <img src={item.icon} alt={item.name} style="width:120px;height:120px;object-fit:contain" />
          ) : (
            <div class="wiki-card__placeholder" style="min-height:180px;width:100%">{item.name.slice(0, 1)}</div>
          )}
        </div>
        <h2 class="wiki-infobox__title">{item.name}</h2>
        <p class="wiki-infobox__sub">ITEM #{item.id}</p>
        <div class="wiki-infobox__rows">
          <div class="wiki-infobox__row"><span class="wiki-infobox__label">分类</span><span class="wiki-infobox__value">{item.category}</span></div>
          {myWeapons[0] && <div class="wiki-infobox__row"><span class="wiki-infobox__label">元素</span><span class="wiki-infobox__value"><span class={`wp-el wp-el--${myWeapons[0].elementKey}`}>{myWeapons[0].element}</span></span></div>}
          {myWeapons[0] && <div class="wiki-infobox__row"><span class="wiki-infobox__label">伤害</span><span class="wiki-infobox__value">{myWeapons[0].damage}</span></div>}
          {myWeapons[0] && <div class="wiki-infobox__row"><span class="wiki-infobox__label">攻速</span><span class="wiki-infobox__value">{myWeapons[0].speed || '—'}</span></div>}
          <div class="wiki-infobox__row"><span class="wiki-infobox__label">可合成</span><span class="wiki-infobox__value">{item.craftable ? '是' : '否'}</span></div>
          <div class="wiki-infobox__row"><span class="wiki-infobox__label">制作站</span><span class="wiki-infobox__value">{item.station || '—'}</span></div>
          <div class="wiki-infobox__row"><span class="wiki-infobox__label">层级</span><span class="wiki-infobox__value">{item.tier || '—'}</span></div>
          <div class="wiki-infobox__row"><span class="wiki-infobox__label">售价</span><span class="wiki-infobox__value">{item.price || 0}</span></div>
        </div>
        <div class="wiki-infobox__badges">
          <a class="wiki-btn" href="/wiki/items/">← 全部物品</a>
          <a class="wiki-btn" href="/wiki/recipes/">合成表</a>
        </div>
      </div>
    </aside>
  </div>
</WikiLayout>

<style>
  .wp-spec { margin: 14px 0 22px; border: 1px solid var(--w-line); background: var(--w-panel); }
  .wp-spec__title {
    margin: 0;
    padding: 10px 12px;
    border-bottom: 1px solid var(--w-line);
    font-family: var(--w-display);
    font-size: 16px;
    font-weight: 400;
    color: var(--w-gold-2);
  }
  .wp-spec__table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .wp-spec__table tr.is-group th {
    padding: 7px 12px;
    background: var(--w-panel-2);
    font-family: var(--w-mono);
    font-size: 9px;
    letter-spacing: .14em;
    color: var(--w-gold);
    text-align: left;
  }
  .wp-spec__table th {
    width: 96px;
    padding: 7px 12px;
    border-bottom: 1px solid var(--w-line);
    font-family: var(--w-mono);
    font-size: 9.5px;
    font-weight: 400;
    letter-spacing: .06em;
    color: var(--w-muted);
    text-align: left;
    vertical-align: top;
    white-space: nowrap;
  }
  .wp-spec__table td {
    padding: 7px 12px;
    border-bottom: 1px solid var(--w-line);
    border-left: 1px solid var(--w-line);
    color: var(--w-soft);
    line-height: 1.7;
  }
  .wp-spec__table tr:last-child th,
  .wp-spec__table tr:last-child td { border-bottom: 0; }
  .wp-spec__dmg {
    font-family: var(--w-mono);
    font-size: 14px;
    color: var(--w-gold-2);
  }
  .wp-spec__obtain {
    display: inline-block;
    padding: 1px 6px;
    border: 1px solid var(--w-line-2);
    font-family: var(--w-mono);
    font-size: 9px;
    letter-spacing: .06em;
  }
  .wp-spec__obtain.is-craft { color: var(--w-green-2); border-color: rgba(120, 163, 122, .45); }
  .wp-spec__obtain.is-buy { color: var(--w-gold-2); border-color: rgba(198, 164, 104, .45); }
  .wp-spec__obtain.is-drop { color: #d9877f; border-color: rgba(185, 86, 78, .5); }
  .wp-spec__recipe { display: flex; flex-wrap: wrap; gap: 3px 8px; }
  .wp-spec__mat { font-size: 12px; white-space: nowrap; }
  .wp-spec__mat i { margin-right: 4px; color: var(--w-faint); font-style: normal; }
  .wp-spec__mat b {
    margin-left: 3px;
    font-family: var(--w-mono);
    font-size: 10px;
    font-weight: 400;
    color: var(--w-gold-2);
  }
  .wp-spec__effect { color: var(--w-soft); }

  .wp-el { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; font-size: 12px; }
  .wp-el::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: .85;
  }
  .wp-el--none { color: var(--w-muted); }
  .wp-el--poison { color: #8fbf6f; }
  .wp-el--fire { color: #dd7a4d; }
  .wp-el--ice { color: #86c8dd; }
  .wp-el--water { color: #6aa5db; }
  .wp-el--thunder { color: #ddc45f; }
  .wp-el--light { color: #e6d295; }
  .wp-el--dark { color: #b183d8; }
</style>
